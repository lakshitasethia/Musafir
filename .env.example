# TEMPLATE ONLY — keep this file blank. Copy it to .env.local (git-ignored) and put real values there.
# Copy to .env.local and fill in what you need. Everything is optional in `npm run dev`.

# Session signing secret. REQUIRED in production (`next start`); dev generates one in .data/.
AUTH_SECRET=

# Shared secret for the scheduled sentinel sweep (POST /api/sentinel with "Authorization: Bearer <secret>").
# Vercel Hobby cron runs only once a day, so use e.g. a GitHub Actions schedule to call it.
SENTINEL_SECRET=

# Operator sign-up. If unset: open in dev (demo mode), disabled in production.
OPERATOR_INVITE_CODE=

# LLM ranking for the alternative-finder agent (free tiers). Without keys the agent
# still works and ranks real OpenStreetMap venues by distance, labelled as such.
GROQ_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_DEEP=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenStreetMap etiquette: a contact email is sent with Nominatim requests.
OSM_CONTACT_EMAIL=
# Comma-separated Overpass instances to try in order (some networks block the default).
OVERPASS_URLS=

# Graph database (Neo4j). If NEO4J_URI is set, ALL data is stored in Neo4j instead of .data/.
# AuraDB Free (no card): console.neo4j.io → New instance → Free. 50k nodes / 175k relationships;
# pauses after 3 days without use (resume it in the console). Import existing data once:
#   npm run db:import-neo4j
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Where the local JSON store lives (default ./.data). Not persistent on serverless hosts.
MUSAFIR_DATA_DIR=

# WhatsApp on-ground help button for travellers: the bot's public number (digits, with country code).
# Optional — if empty the app reads it from Meta with WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID.
WHATSAPP_DISPLAY_NUMBER=

# Nugen (HackCelestial): API key from platform.nugen.in; NUGEN_MODEL = aligned model id printed by scripts/nugen-align.mts deploy.
NUGEN_API_KEY=
NUGEN_MODEL=
