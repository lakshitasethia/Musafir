# Copy to .env.local and fill in what you need. Everything is optional in `npm run dev`.

# Session signing secret. REQUIRED in production (`next start`); dev generates one in .data/.
AUTH_SECRET=

# Operator sign-up. If unset: open in dev (demo mode), disabled in production.
OPERATOR_INVITE_CODE=

# LLM ranking for the alternative-finder agent (free tiers). Without keys the agent
# still works and ranks real OpenStreetMap venues by distance, labelled as such.
GROQ_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_DEEP=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenStreetMap etiquette: a contact email is sent with Nominatim requests.
OSM_CONTACT_EMAIL=
# Comma-separated Overpass instances to try in order (some networks block the default).
OVERPASS_URLS=

# Where the local JSON store lives (default ./.data). Not persistent on serverless hosts.
MUSAFIR_DATA_DIR=
