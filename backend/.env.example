# Copy to .env. Values here work for running on the host against `docker compose` db/redis;
# docker compose overrides DATABASE_URL and REDIS_URL for the containers.
DATABASE_URL=postgresql+asyncpg://musafir:musafir@localhost:5433/musafir
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# Comma-separated
CORS_ORIGINS=http://localhost:3000

# LLM (Phase 2). LLM_MOCK=true never calls Gemini.
GEMINI_API_KEY=
GEMINI_MODEL_LITE=gemini-2.5-flash-lite
GEMINI_MODEL_MAIN=gemini-2.5-flash
LLM_MOCK=true

# Integrations (later phases)
GOOGLE_PLACES_API_KEY=
ORS_API_KEY=
VIATOR_API_KEY=
LITEAPI_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
