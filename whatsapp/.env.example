# Copy to .env and fill in. See README.md for where each value comes from.

# --- WhatsApp Cloud API (Meta developer app -> WhatsApp -> API Setup) ---
# Leave ACCESS_TOKEN / PHONE_NUMBER_ID empty to run without Meta: outbound messages are logged.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; paste the same value into Meta's webhook "Verify token" field.
WHATSAPP_VERIFY_TOKEN=
# App settings -> Basic -> App secret. Used to verify X-Hub-Signature-256 on every webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v25.0

# --- Groq (console.groq.com -> API Keys, free tier) ---
GROQ_API_KEY=
# Primary model, then fallbacks tried in order if a model isn't available to your key.
# List what your key can use: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,llama-3.3-70b-versatile

# --- Musafir backend (the FastAPI app in ../backend) ---
MUSAFIR_API_URL=http://localhost:8000

# Public HTTPS URL of THIS service (your ngrok / cloudflared tunnel). Used for account-link pages.
PUBLIC_BASE_URL=http://localhost:8100

# Optional contact (email or URL) sent in the User-Agent, as OpenStreetMap services ask.
# Use a real one or leave empty: placeholder addresses get blocked (HTTP 403).
OSM_CONTACT=

DATABASE_PATH=whatsapp.db
